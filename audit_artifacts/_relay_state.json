 등)를 추출했다. fpCloneX와 fpCyberKongz 두 풀이 직접 공격 대상이 되었으며, 온체인 직접 유출은 ~$40K였지만 NFT 시장에서의 총 손실은 ~$1.5M~$1.6M로 집계되었다.","priority":1,"slug":"modeb-ethereum-152-000000248d4a","sort_rank":1520348.0,"sort_rank_dec":"1520348","tvl_usd":100000.0,"tvl_usd_dec":"100000","verdict":"미검증 차단"}],"engine_meta":{"corpus_md_evm_cases":"301","corpus_md_partition_seal":"{\"corpus_sha256\": \"fe2171e9900f8cbda619f2174089036538fba87bc6280c8ba0820a459002215f\", \"evm_case_slug_map\": {\"0\": [\"modeb-base-000-dac30a7e6fff\"], \"1\": [\"modeb-ethereum-001-f5b3164a485a\"], \"2\": [\"modeb-arbitrum-002-e80fb6bccfb1\"], \"3\": [\"modeb-arbitrum-003-a912677f014b\"], \"4\": [\"modeb-ethereum-004-764c64302ef2\"], \"5\": [\"modeb-arbitrum-005-f7ca73ed80bc\"], \"6\": [\"modeb-bsc-006-2f3f25722ced\"], \"7\": [\"modeb-arbitrum-005-f7ca73ed80bc\"], \"8\": [\"modeb-ethereum-008-6b00683df721\"], \"9\": [\"modeb-base-009-c859ac4fb371\"], \"10\": [\"modeb-ethereum-010-ba411e1e73aa\"], \"11\": [\"modeb-bsc-011-cd678a9ffc83\"], \"12\": [\"modeb-ethereum-012-d83d96fa8913\"], \"13\": [\"modeb-ethereum-013-61600023757e\", \"modeb-arbitrum-013-61600023757e\", \"modeb-base-013-61600023757e\", \"modeb-bsc-013-61600023757e\"], \"14\": [\"modeb-bsc-014-99003c0d2e63\"], \"15\": [\"modeb-bsc-015-b41327747854\"], \"16\": [\"modeb-ethereum-016-79ec4a28bbc5\"], \"17\": [\"modeb-base-017-66a248d3e129\"], \"18\": [\"modeb-avalanche-018-b2185902e063\", \"modeb-ethereum-018-b2185902e063\", \"modeb-arbitrum-018-b2185902e063\", \"modeb-optimism-018-b2185902e063\", \"modeb-polygon-018-b2185902e063\", \"modeb-mantle-018-b2185902e063\", \"modeb-linea-018-b2185902e063\", \"modeb-base-018-b2185902e063\", \"modeb-celo-018-b2185902e063\", \"modeb-bsc-018-b2185902e063\"], \"19\": [\"modeb-ethereum-019-f5e48f927e19\"], \"20\": [\"modeb-ethereum-020-02411cd6e758\"], \"21\": [\"modeb-bsc-021-560d39f1250b\"], \"22\": [\"modeb-bsc-022-af1925cc3716\"], \"23\": [\"modeb-bsc-023-aeb41408df42\"], \"24\": [\"modeb-bsc-024-02739bdd9faa\"], \"25\":