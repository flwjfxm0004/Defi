// Season 2 Weapon 07: Abyss × Attack — Vortex Chain Whip
fn on_tick(self, target) {
    has_trait_bit abyss_brand = self, 6
    read_pos sp = self
    read_pos tp = target
    dist_sq_vec3 gap = tp, sp
    read_charge ch = self
    const_q32_milli hp = 10850
    const_q32_milli sh = 15000
    const_q32 cg = 8
    emit_damage hp, sh, cg
    if abyss_brand {
        const_q32 rad = 12
        const_q32_milli slow = 250
        emit_phantasia sp, rad, slow
    endif
}
