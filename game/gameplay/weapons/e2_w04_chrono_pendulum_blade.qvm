// Season 2 Weapon 04: Chrono × Attack — Pendulum Dual Blade
fn on_tick(self, target) {
    read_charge sch = self
    const_q32 zero = 0
    cmp_ge_q32 active = sch, zero
    read_hp thp = target
    const_q32 high = 5000
    cmp_lt_q32 under_cap = thp, high
    read_pos sp = self
    read_vel sv = self
    const_q32 one = 1
    fma_vec3 arc = sv, one, sp
    const_q32_milli hp = 11000
    const_q32_milli sh = 15000
    const_q32 cg = 8
    emit_damage hp, sh, cg
    has_trait_bit chrono_echo = self, 5
}
