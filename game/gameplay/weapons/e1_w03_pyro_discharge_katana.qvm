// Season 1 Weapon 03: Pyro × Attack — Ignition Discharge Katana
fn on_tick(self, target) {
    read_charge ch = self
    read_pos sp = self
    read_pos tp = target
    dist_sq_vec3 d2 = tp, sp
    const_q32_milli hp = 11000
    const_q32_milli sh = 15000
    const_q32 cg = 9
    emit_damage hp, sh, cg
    has_trait_bit pyro_resonance = self, 13
    if pyro_resonance {
        const_q32 burst = 40
        emit_clash burst
    endif
}
